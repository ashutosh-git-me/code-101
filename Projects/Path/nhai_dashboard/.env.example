# ============================================
# NHAI Command Center — Environment Variables
# ============================================
# Copy this file to .env.local for development.
# Add these same keys in your Vercel dashboard:
#   Settings → Environment Variables
# ============================================

# Google Maps API Key (exposed to browser for map rendering)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Edge Node Authentication Token (server-side secret)
# Flutter Edge Nodes must send this as the "x-edge-token" header
# to authenticate POST/DELETE requests to /api/telemetry.
EDGE_SECRET_TOKEN=

# The same token exposed to the browser for the built-in Simulator page.
# Must match EDGE_SECRET_TOKEN above.
NEXT_PUBLIC_EDGE_TOKEN=

# Admin Dispatcher Password
# Used by the /login page to grant access to the Command Center.
ADMIN_PASSWORD=

# The password displayed on the login page as a demo hint for judges.
# Must match ADMIN_PASSWORD above.
NEXT_PUBLIC_DEMO_PASSWORD=
